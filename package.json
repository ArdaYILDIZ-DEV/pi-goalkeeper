{
  "name": "goalkeeper",
  "version": "0.1.0",
  "description": "Goalkeeper: bounded, session-aware goal continuation for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArdaYILDIZ-DEV/pi-goalkeeper.git"
  },
  "homepage": "https://github.com/ArdaYILDIZ-DEV/pi-goalkeeper#readme",
  "bugs": "https://github.com/ArdaYILDIZ-DEV/pi-goalkeeper/issues",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "@types/node": "22.19.19"
  }
}
